# 用于默认 providers.yaml；改成容器能够访问的 LLM 网关地址。
LLM_API_BASE=http://your-llm-gateway:8000/v1
# providers.yaml 使用 key_env: OPENCODE_GO_API_KEY 时填写。
OPENCODE_GO_API_KEY=

# 留空表示直连；填写容器可以访问的代理地址。
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1

# 部署者可继续添加任意用户环境变量，使用 Docker env-file 的 KEY=value 格式。
# 这些变量会传给容器、Leader、Worker 和 docker exec 打开的 shell。
# TZ=Asia/Shanghai
# LANG=C.UTF-8
# MY_VARIABLE=your-value
