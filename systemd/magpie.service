[Unit]
Description=Magpie gateway and Web services

[Service]
Type=exec
User=node
Group=node
EnvironmentFile=/run/clawteam/agent.env
ExecStart=/opt/venv/bin/python3 /usr/local/lib/clawteam-docker/systemd_runtime.py magpie
Restart=always
RestartSec=3
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
